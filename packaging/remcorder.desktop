[Desktop Entry]
Type=Application
Name=Remcorder
GenericName=Screen Recorder
Comment=GPU-accelerated screen recording
Exec=remcorder --trim %f
Icon=remcorder
Terminal=false
Categories=AudioVideo;Recorder;
Keywords=screen;recording;capture;wayland;gpu;
StartupNotify=true
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/mp2t;video/x-flv;video/3gpp;video/ogg;video/x-ms-wmv;
