[Unit]
Description=Remcorder GPU-accelerated screen recorder
Documentation=https://github.com/remcostoeten/remcorder
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=REMCORDER_DAEMON_ARGS=
EnvironmentFile=-%h/.config/remcorder/daemon.env
ExecStart=%h/.local/bin/remcorderd $REMCORDER_DAEMON_ARGS
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
